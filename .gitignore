# dependencies
/node_modules

# production
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# typescript
*.tsbuildinfo

# Cloudflare / OpenNext (旧)
.vercel
.open-next

# Claude Code / MCP（git管理しない）
.mcp.json
.claude/
.playwright-mcp/

# Playwright テスト出力
test-results/

# スクリーンショット（作業用）
*.png
# OGPアセットは除外対象外
!public/ogp/*.png

# GAS clasp設定（scriptIdを公開しない）
gas/.clasp.json

# ドキュメント・指示書（ローカルのみ）
*.md

# 音声ファイルは絶対に入れない
# 曲の解析で一時的に音源を扱うが、必ず消す運用。確認用に作るクリック音付きの
# 音声は元の音源を含むので、うっかり追加されないよう仕組みで塞いでおく。
*.mp3
*.wav
*.webm
*.m4a
*.flac
*.opus

# 解析スクリプトの副産物
scripts/song-structure/**/__pycache__/
